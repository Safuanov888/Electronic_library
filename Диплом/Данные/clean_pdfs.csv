'); или SELECT * (= 'Cisneros'); 2. SELECT DISTINCT cname, rating FROM Customers, OrdersWHERE amt > (SELECT AVG (amt) FROM Orders) AND Orders.cnum = Customers.cnum; 3. SELECT snum, SUM (amt) (amt) > (SELECT MAX (amt) FROM Orders); Глава11 1. SELECT cnum, = (SELECT MAX (rating) .city = outer.city); 2.Решение с помощью соотнесенного подзапроса : SELECT snum, (.snum <> main.snum); 3.Решение с помощью объединения : SELECT DISTINCT first.snum, , Customers secondWHERE first.city = second.city AND first.snum <> second.snum;Соотнесенный подзапрос находит всех заказчиков ,не обслуживаемых данным продавцом ,и выясняет :живет ли кто -нибудь из них в его городе .Решение с помощью обьединения является более простым и более интуитивным .Оно находит случаи ,где поляcityсовпадают ,ап о л яsnums нет.Следовательно ,обьединение является более изящным решением для этой проблемы ,чем то,которое мы исследовали до этого . Имеется еще более изящное решение с помощью подзапроса ,с которым Вы столкне тесь позже . Глава12 1. SELECT * (SELECT * .snum = second.= 300); 2. SELECT a.snum, sname, a.city, , Customers bWHERE a.snum = b.snum AND b.rating = 300; 3. SELECT * (SELECT * .city = a.city AND a.snum <> b.snum); 4. SELECT * (SELECT * .snum = b.snum AND a.cnum <> b.cnum) Глава13 1. SELECT * >= ANY (= 1002); 2. 2002 Giovanni Rome 200 1003 2003 200 10022004 Grass Berlin 300 10022008 Cisneros SanJose 300 10073. SELECT * <> ALL (); или SELECT * = ANY (); 4. SELECT * > ALL (, Customers bWHERE a.cnum = b.cnum AND b.city = 'London'); 5. SELECT * > (SELECT MAX (amt) FROM Orders a, Customers bWHERE a.cnum = b.cnum AND b.city = 'London'); Глава14 1. SELECT cname, city, rating, 'High Rating' >= 200 UNIONSELECT cname, city, rating, ' Low Ratlng' < 200; или SELECT cname, city, rating, 'High Rating' >= 200 UNIONSELECT cname, city, rating, ' Low Rating' >= 200; Различие между этими двумя предложениями —в форме второго предиката .Обратите внимание ,что в обоих случаях строка ""Low Rating"" имеет в начале допол